# ===========================================
# ENIGMA - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# Next.js
# Public base URL used for absolute links, OG images, and callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
# Project URL from the Supabase dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon (public) key – safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key – server-side only, bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL)
# Pooled connection via pgbouncer for queries (port 6543 in production)
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres?pgbouncer=true
# Direct connection for Prisma migrations and schema introspection (port 5432)
DIRECT_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Avalanche Blockchain
# Network environment: testnet | mainnet
NEXT_PUBLIC_CHAIN_ENV=testnet
# Primary JSON-RPC endpoint for the Avalanche C-Chain
NEXT_PUBLIC_AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Fallback RPC used when the primary endpoint is unreachable
AVALANCHE_RPC_FALLBACK_URL=https://rpc.ankr.com/avalanche_fuji

# WalletConnect
# Project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id

# Sentry (Error Tracking) - Optional
# DSN for server-side error reporting
SENTRY_DSN=
# DSN for client-side error reporting (exposed to browser)
NEXT_PUBLIC_SENTRY_DSN=
# Sentry organization slug
SENTRY_ORG=
# Sentry project slug
SENTRY_PROJECT=
# Auth token for uploading source maps during build
SENTRY_AUTH_TOKEN=

# x402 Payment Protocol
# Enable to require payment for sentinel scans
X402_PAYMENT_ENABLED=false
# Recipient address for x402 payments (0x format)
X402_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000

# x402 Payment (CLI script)
# Private key of the paying agent wallet (hex with 0x prefix)
PAYER_PRIVATE_KEY=
# x402 facilitator URL for on-chain settlement
FACILITATOR_URL=https://facilitator.ultravioletadao.xyz

# Agent Identity (Web4 Survival)
AGENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
